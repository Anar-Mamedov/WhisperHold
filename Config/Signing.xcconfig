// Code signing defaults that work for anyone who clones the repository:
// "Sign to Run Locally" (ad-hoc), no Apple Developer account needed.
//
// macOS ties the Microphone, Input Monitoring and Accessibility grants to the
// app's signature. An ad-hoc signature changes on every build, so each rebuild
// asks for those permissions again. To keep them across builds, sign with your
// own certificate: copy Local.xcconfig.example to Local.xcconfig (git-ignored)
// and fill in your team.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
